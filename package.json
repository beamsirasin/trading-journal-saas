{
  "name": "trading-os",
  "version": "0.1.0",
  "private": true,
  "description": "Trading journal SaaS that separates system performance from trader execution.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "e2e:known-red": "node scripts/compare-known-red-e2e.mjs",
    "test:money": "vitest run src/lib/money",
    "test:time": "vitest run src/lib/time",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "analytics:benchmark": "node --env-file=.env.local scripts/benchmark-analytics.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "db:test:reset": "node scripts/reset-test-database.mjs",
    "platform-admin": "node scripts/platform-admin.mjs",
    "email:verify": "node scripts/email-verify.mjs",
    "email:smoke": "node scripts/email-smoke.mjs",
    "scan:client": "node scripts/scan-client-assets.mjs",
    "seed:visual-dashboard": "tsx --conditions=react-server --env-file=.env.local scripts/seed-visual-dashboard.ts",
    "validate:visual-dashboard-ids": "tsx --conditions=react-server --env-file=.env.local scripts/validate-visual-dashboard-id-isolation.ts",
    "validate:visual-dashboard-d5": "tsx --conditions=react-server --env-file=.env.local scripts/validate-visual-dashboard-d5.ts",
    "validate:visual-dashboard-d6": "tsx --conditions=react-server --env-file=.env.local scripts/validate-visual-dashboard-d6.ts",
    "validate:visual-dashboard-d7": "tsx --conditions=react-server --env-file=.env.local scripts/validate-visual-dashboard-d7.ts",
    "validate:visual-dashboard-d8": "tsx --conditions=react-server --env-file=.env.local scripts/validate-visual-dashboard-d8.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm scan:client"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/env": "16.2.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
