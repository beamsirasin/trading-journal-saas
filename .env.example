# =============================================================================
# Trading OS — environment variable reference
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
#
# THIS FILE CONTAINS VARIABLE NAMES ONLY. Never commit a real secret, key,
# connection string, or token here. See CLAUDE.md §10.
#
# Variables are grouped by the phase that introduces them. Anything marked
# "not yet used" is documented ahead of time so the reference stays complete;
# it is optional in `src/config/env.schema.ts` until its phase lands, so an
# unconfigured integration never breaks a build or a preview deployment.
#
# -----------------------------------------------------------------------------
# Environment responsibilities
# -----------------------------------------------------------------------------
# LOCAL       `.env.local`, never committed. Point DATABASE_URL at the Docker
#             Postgres (see docker-compose.yml) or a personal Neon branch.
#             Use throwaway OAuth credentials against localhost callbacks.
#
# PREVIEW     Per-branch deployments. Must use a NON-PRODUCTION database — a
#             preview branch running migrations against production data is the
#             failure this separation exists to prevent. Secrets are set in the
#             hosting platform, never in the repository.
#
# PRODUCTION  Set only in the hosting platform's encrypted store. Rotated
#             independently of preview. Migrations run as an explicit,
#             reviewed step, never automatically on boot.
# =============================================================================


# --- Application (Phase 00) --------------------------------------------------

# Public base URL. Used for absolute links and OAuth callbacks.
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=


# --- Database (Phase 00b/02) -------------------------------------------------

# Pooled connection, used by the application at runtime — Better Auth,
# reads, writes, server components, route handlers, server actions.
#
# Local (Docker Compose defaults):
#   postgresql://trading_os:trading_os_dev@127.0.0.1:5432/trading_os
# Production: the Neon POOLED endpoint.
#
# Deliberately a plain DATABASE_URL so the app stays portable to a VPS
# (CLAUDE.md §2). Do not adopt provider-specific connection helpers.
DATABASE_URL=

# Direct (unpooled) connection, used ONLY for `db:generate`/`db:migrate` and
# database administration commands — never by the running application.
#
# Transaction poolers do not hold advisory locks across a connection, which
# breaks DDL and can corrupt the migration journal. On Neon this is the direct
# endpoint (see docs/neon-setup.md). On a plain PostgreSQL server there is no
# distinction — leave this blank and DATABASE_URL is used, with the fallback
# printed (never silent) by drizzle.config.ts.
DATABASE_MIGRATION_URL=

# A dedicated, disposable database used ONLY by `pnpm test:integration`.
# NEVER point this at a database that holds anything you care about — the
# integration suite creates and drops schema objects freely. Must be a
# different database from DATABASE_URL; the test runner refuses to start
# otherwise. See docs/migration-runbook.md.
TEST_DATABASE_URL=

# Optional overrides for the local Docker Postgres. Defaults are in
# docker-compose.yml. These are development-only and are not secrets.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=


# --- Authentication (Phase 02 — Better Auth) ---------------------------------

# Session/cookie signing key. Generate with: openssl rand -base64 32
# In production, a missing or weak/placeholder-looking value fails closed at
# first use (src/lib/auth/server.ts) rather than silently signing with a
# guessable key.
BETTER_AUTH_SECRET=

# Canonical URL Better Auth uses to build callback and cookie URLs.
# Local: http://localhost:3000
BETTER_AUTH_URL=

# Comma-separated additional origins allowed to receive auth responses
# (e.g. a Vercel preview domain). BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL are
# always trusted; this is for origins beyond those. See docs/google-oauth-setup.md.
BETTER_AUTH_TRUSTED_ORIGINS=

# Google OAuth credentials, from the Google Cloud Console. Both must be set
# for the Google sign-in button to appear — see docs/google-oauth-setup.md.
# Leaving these unset does not break the build; the button is truthfully
# hidden/disabled with a localized explanation instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email delivery (Phase 02 — not yet used) --------------------------------
#
# No transactional email provider is configured yet. Verification and
# password-reset emails use a console-only adapter in development and a
# fail-closed adapter in production (src/lib/auth/email.ts) — production
# email/password signup requiring verification will surface a clear error
# rather than pretend an email was sent. A real provider (e.g. Resend) is
# planned for a later phase; see docs/email-delivery-setup.md.
