# =============================================================================
# Trading OS — environment variable reference
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
#
# THIS FILE CONTAINS VARIABLE NAMES ONLY. Never commit a real secret, key,
# connection string, or token here. See CLAUDE.md §10.
#
# Variables are grouped by the phase that introduces them. Anything marked
# "not yet used" is documented ahead of time so the reference stays complete;
# it is optional in `src/config/env.ts` until its phase lands.
# =============================================================================


# --- Application (Phase 00) --------------------------------------------------

# Public base URL of the app. Used for absolute links and OAuth callbacks.
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=


# --- Database (Phase 01 — not yet used) --------------------------------------

# Standard PostgreSQL connection string.
# Development: a local Postgres instance.
# Production:  Neon.
# Deliberately a plain DATABASE_URL so the app stays portable to a VPS
# (CLAUDE.md §2). Do not adopt provider-specific connection helpers.
DATABASE_URL=


# --- Authentication (Phase 02 — not yet used) --------------------------------

# Secret used to encrypt session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL Auth.js uses to build callback URLs.
AUTH_URL=

# Google OAuth credentials, from the Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transactional email provider, used for magic-link sign-in.
AUTH_EMAIL_FROM=
AUTH_RESEND_KEY=
